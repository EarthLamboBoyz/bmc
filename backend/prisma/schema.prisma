generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// User & Authentication
// ============================================

// Enum: BRAND, CREATOR
model User {
  id            String          @id @default(uuid())
  email         String          @unique
  passwordHash  String
  role          String          // UserRole enum
  
  brandProfile   BrandProfile?
  creatorProfile CreatorProfile?
  notifications  Notification[]
  
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  
  @@map("users")
}

// ============================================
// Brand Profile
// ============================================

model BrandProfile {
  id            String       @id @default(uuid())
  userId        String       @unique
  companyName   String
  logo          String?
  industry      String?
  description   String?
  website       String?
  phone         String?
  address       String?      // Simple string for Brand address
  
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaigns     Campaign[]
  transactions  Transaction[] @relation("BrandTransactions")
  
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  
  @@map("brand_profiles")
}

// ============================================
// Creator Profile
// ============================================

// Enum: PROMPTPAY, BANK_TRANSFER
model CreatorProfile {
  id              String         @id @default(uuid())
  userId          String         @unique
  displayName     String
  avatar          String?
  bio             String?
  phone           String?
  address         String?        // JSON String for detailed address (line1, line2, district, province, postalCode)
  tiktokHandle    String?
  instagramHandle String?
  youtubeHandle   String?
  followersCount  Int            @default(0)
  categories      String         @default("[]") // JSON String for SQLite
  
  // Payment Information
  paymentMethod   String?        // PaymentMethod enum
  promptpayId     String?        // Phone number or ID card number
  bankName        String?
  bankAccountNo   String?
  bankAccountName String?
  
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications    Application[]
  submissions     Submission[]
  transactions    Transaction[]  @relation("CreatorTransactions")
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  
  @@map("creator_profiles")
}

// ============================================
// Campaign System
// ============================================

// Enum: DRAFT, ACTIVE, PAUSED, COMPLETED, CANCELLED
model Campaign {
  id              String          @id @default(uuid())
  brandId         String
  title           String
  description     String
  coverImage      String?
  budget          Float
  type            String          @default("single") // single, challenge
  rewardPerPost   Float?          // Optional/Deprecated in favor of rewards structure
  status          String          @default("DRAFT") // CampaignStatus enum
  startDate       DateTime
  endDate         DateTime
  announceDate    DateTime?       // Add announce date

  // Requirements
  minFollowers    Int             @default(0)
  platforms       String          @default("[]") // JSON String
  categories      String          @default("[]") // JSON String
  
  // Complex Data (JSON Strings)
  rewards             String      @default("[]") // JSON String for RewardConfig[]
  contentGuidelines   String?     // JSON String for ContentGuidelines
  hasSamples          Boolean     @default(false)
  sampleInfo          String?     // JSON String for SampleInfo
  
  brand           BrandProfile    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  applications    Application[]
  submissions     Submission[]
  transactions    Transaction[]
  
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  
  @@map("campaigns")
}

// ============================================
// Application & Submission
// ============================================

// Enum: PENDING, APPROVED, REJECTED
model Application {
  id          String            @id @default(uuid())
  campaignId  String
  creatorId   String
  status      String            @default("PENDING") // ApplicationStatus enum
  message     String?
  
  campaign    Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creator     CreatorProfile    @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  
  @@unique([campaignId, creatorId])
  @@map("applications")
}

// Enum: PENDING, APPROVED, REJECTED, REVISION_REQUESTED
model Submission {
  id              String           @id @default(uuid())
  campaignId      String
  creatorId       String
  
  // Content Details
  contentUrl      String
  promoLink       String?          // Affiliate or promo link
  caption         String?
  platform        String           // TikTok, Instagram, YouTube
  day             Int?             // For challenge campaigns (Day 1, Day 2, etc.)
  
  // Metrics
  views           Int              @default(0)
  likes           Int              @default(0)
  comments        Int              @default(0)
  shares          Int              @default(0)
  
  // Review
  status          String           @default("PENDING") // SubmissionStatus enum
  reviewNote      String?          // Brand's feedback
  revisionCount   Int              @default(0)
  
  campaign        Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creator         CreatorProfile   @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  transactions    Transaction[]
  
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  
  @@map("submissions")
}

// ============================================
// Transaction & Payment
// ============================================

// Enum: PENDING, PAID, CONFIRMED, DISPUTED, RESOLVED
model Transaction {
  id              String            @id @default(uuid())
  
  // Parties
  brandId         String
  creatorId       String
  campaignId      String?
  submissionId    String?
  
  // Payment Details
  amount          Float
  paymentMethod   String            // PaymentMethod enum
  
  // Status
  status          String            @default("PENDING") // TransactionStatus enum
  
  // Payment Proof
  proofImageUrl   String?           // Slip image
  transferDate    DateTime?
  
  // Recipient Info (snapshot at creation)
  recipientInfo   String            // JSON String for SQLite
  
  // Notes
  brandNote       String?
  creatorNote     String?
  
  // Relations
  brand           BrandProfile      @relation("BrandTransactions", fields: [brandId], references: [id], onDelete: Cascade)
  creator         CreatorProfile    @relation("CreatorTransactions", fields: [creatorId], references: [id], onDelete: Cascade)
  campaign        Campaign?         @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  submission      Submission?       @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  
  @@map("transactions")
}

// ============================================
// GMV Upload System
// ============================================

model CreatorCampaignStats {
  id                   String          @id @default(uuid())
  campaignId           String
  creatorId            String
  
  // Submission Stats
  totalSubmissions     Int             @default(0)
  approvedSubmissions  Int             @default(0)
  currentStreak        Int             @default(0)
  longestStreak        Int             @default(0)
  
  // GMV Data (uploaded by Brand)
  gmv                  Float           @default(0)
  orders               Int             @default(0)
  lastGmvUpdate        DateTime?
  
  // Performance Metrics
  totalViews           BigInt          @default(0)
  totalLikes           BigInt          @default(0)
  totalComments        BigInt          @default(0)
  totalShares          BigInt          @default(0)
  
  // Milestones achieved (JSON String)
  milestonesAchieved   String          @default("[]")
  
  // Current rank
  currentRank          Int?
  
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  
  @@unique([campaignId, creatorId])
  @@map("creator_campaign_stats")
}

model GmvUpload {
  id            String    @id @default(uuid())
  campaignId    String
  uploadedBy    String
  
  // File info
  fileName      String
  fileUrl       String?
  
  // Stats
  totalCreators Int?
  totalGmv      Float?
  totalOrders   Int?
  
  // Status
  processed     Boolean   @default(false)
  errorMessage  String?
  
  // Timestamps
  uploadedAt    DateTime  @default(now())
  processedAt   DateTime?
  
  @@map("gmv_uploads")
}

// ============================================
// Notification System
// ============================================

// Enum: APPLICATION_APPROVED, ETC
model Notification {
  id          String           @id @default(uuid())
  userId      String
  type        String           // NotificationType enum
  title       String
  message     String
  link        String?
  isRead      Boolean          @default(false)
  
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime         @default(now())
  
  @@map("notifications")
}
